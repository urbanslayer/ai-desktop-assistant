# Copy this file to .env and paste your keys after the = signs.
# .env is git-ignored, so your keys never get committed.
# Leave a line empty if that server doesn't need a key.

# Your local LLM server (llm.base_url in character_config.yaml).
LLM_API_KEY=

# Only if server/asr_server.py was started with ASR_API_KEY set (asr: remote).
ASR_API_KEY=

# Only for tts: openai, if that server needs a key.
TTS_API_KEY=

# Only for asr: groq. Free tier. https://console.groq.com/keys
GROQ_API_KEY=

# Only for tts: fish. Sign up at https://fish.audio/?fpr=rayen10 then create a key under API keys.
FISH_API_KEY=

# The avatar page's local web port (riko/viewer.py). Default 8080.
# Set this if something else on this PC already uses 8080; riko-ctl then wants
# RIKO_URL=http://127.0.0.1:<port> to match.
# RIKO_PORT=8080
