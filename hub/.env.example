# Copy to hub/.env — docker compose reads it automatically.

# Require "Authorization: Bearer <this>" from every client (and type it into
# the web config page too). Empty = open LAN access, not recommended.
RIKO_HUB_KEY=

# Host port the container's 8002 is published on.
RIKO_HUB_PORT=8002

# The OpenAI-compatible LLM she thinks with (vLLM, llama.cpp, LM Studio, ...).
RIKO_LLM_BASE_URL=http://192.0.2.51:8000/v1
RIKO_LLM_API_KEY=
RIKO_LLM_MODEL=auto

# Voice (docs/VOICE.md). Breeze-TTS-2 runs in its own compose stack on the
# shared `riko` docker network (create it once on the host:
# `docker network create riko`). Inside docker use the service name; from
# outside use http://<gpu-box>:8137. Empty RIKO_TTS_BASE_URL = voice off:
# no audio is made and every audio_url stays null. The hub alone talks to
# breeze — clients only fetch the hub's /api/.../audio URLs.
RIKO_TTS_BASE_URL=http://breeze-tts:8137
RIKO_TTS_ENABLED=1

# Web tools (docs/API.md "Tools"). RIKO_SEARXNG_URL is the SearXNG backend
# behind web_search: a URL reachable from the container (LAN IP or a service
# on the shared `riko` network), no trailing slash needed. Empty = web_search
# off. RIKO_ALLOW_PRIVATE_FETCH=1 lets fetch_page follow links to private /
# loopback addresses — off by default (SSRF guard); enable only on a trusted
# LAN.
RIKO_SEARXNG_URL=
RIKO_ALLOW_PRIVATE_FETCH=0

# Weather (docs/API.md "Weather"). The weather tool is built in and needs no
# key — it calls Open-Meteo directly. RIKO_LOCATION is a default home place
# (a town name like "Gloucester, UK") used until the owner picks a place on
# the Settings page; RIKO_UNITS=imperial speaks weather in °F / mph / inches.
RIKO_LOCATION=
RIKO_UNITS=metric

# Home Assistant (README "Home Assistant"): RIKO_HA_URL is your HA base URL,
# e.g. https://homeassistant.example.com. RIKO_HA_TOKEN is a Home Assistant
# long-lived access token for the homeassistant MCP server; create it under
# your HA profile > Security. Both set = the hub offers the built-in
# 'homeassistant' MCP server (/api/mcp/assist). The token stays in this
# file / the hub process — it never goes into the database or the web page.
RIKO_HA_URL=
RIKO_HA_TOKEN=

# Timers (docs/TIMERS.md): the container's wall-clock zone — timer due times
# and every spoken time use it unless the settings page saves its own
# `timezone`. RIKO_TIMER_POLL_S is how often the hub checks for due timers
# (seconds, minimum 1).
TZ=Europe/London
RIKO_TIMER_POLL_S=1

# Own the files docker writes into ./data (run `id -u` and `id -g` on the host).
UID=1000
GID=1000
