# Copy to hub/.env — docker compose reads it automatically.

# Require "Authorization: Bearer <this>" from every client (and type it into
# the web config page too). Empty = open LAN access, not recommended.
RIKO_HUB_KEY=

# Host port the container's 8002 is published on.
RIKO_HUB_PORT=8002

# The OpenAI-compatible LLM she thinks with (vLLM, llama.cpp, LM Studio, ...).
RIKO_LLM_BASE_URL=http://192.0.2.51:8000/v1
RIKO_LLM_API_KEY=
RIKO_LLM_MODEL=auto

# Own the files docker writes into ./data (run `id -u` and `id -g` on the host).
UID=1000
GID=1000
