# Copy to server/.env — docker compose reads it automatically.

# Faster-Whisper model name or path (any model Faster-Whisper knows).
ASR_MODEL=large-v3-turbo

# Require "Authorization: Bearer <key>" from clients; empty = open LAN access.
ASR_API_KEY=

# Host port the container's 8001 is published on.
ASR_PORT=8001

# Own the files docker writes into ./data (run `id -u` and `id -g` on the host).
UID=1000
GID=1000

# Set to 1 once the model is in ./data to start fully offline.
#HF_HUB_OFFLINE=0
