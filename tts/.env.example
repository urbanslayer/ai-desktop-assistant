# Copy to .env next to compose.yaml. Everything here has a working default
# except VIDEO_GID/RENDER_GID, which you only need with compose.amd.yaml.

# Which GGUF weights breeze loads (downloaded once into ./data/models on first
# start). See tts/README.md for the size/VRAM table:
#   breeze-tts-2-q8_0.gguf  3.3 GB, ~4 GB VRAM  (recommended)
#   breeze-tts-2-q4_k.gguf  2.4 GB              (fits smaller cards)
#   breeze-tts-2-q6_k.gguf / breeze-tts-2-f16.gguf  (bigger / best)
#BREEZE_MODEL=breeze-tts-2-q8_0.gguf

# Extra flags for breeze-server, e.g. "--webui --parallel 2"
# (--webui turns on its own little web page; add ports in compose.yaml for it)
#BREEZE_ARGS=

# NVIDIA (CUDA image) only: GPU architectures to compile for. Default
# "86;89;120" (Ampere/Ada/Blackwell). Set it to just your card for a much
# faster first build: 120 = RTX 50xx, 89 = RTX 40xx, 86 = RTX 30xx, 75 = Turing.
# (Ignored by the AMD/CPU overrides, which use the prebuilt Vulkan image.)
#CUDA_ARCHS=86;89;120

# Keep ./data owned by your host user. Defaults to 1000:1000; check with `id`.
#UID=1000
#GID=1000

# Only for compose.amd.yaml (AMD/Intel GPU through /dev/dri): the NUMERIC gids
# of the video and render groups on the host. Look them up with:
#   getent group video render
#VIDEO_GID=985
#RENDER_GID=989
