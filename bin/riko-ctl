#!/usr/bin/env python3
"""Control a running Riko desktop app from anywhere. Bind these to keys in your compositor.

    riko-ctl type         open the text box (and focus her window)
    riko-ctl talk         start / stop recording from your mic
    riko-ctl talk-start   start recording   (bind to key press)
    riko-ctl talk-stop    stop and send     (bind to key release)
    riko-ctl toggle       show / hide her   (also: show, hide)
    riko-ctl forget       clear the chat history (on the hub, for this persona)
    riko-ctl personas     list personas and which one is active
    riko-ctl persona NAME switch who she is (id, name or keyword; case doesn't matter)
    riko-ctl persona-next switch to the next persona on the hub (cycles around)
    riko-ctl quit
    riko-ctl status

Standard library only, so it starts fast and needs no virtualenv.
"""
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

URL = os.environ.get("RIKO_URL", "http://127.0.0.1:8080")
APP_ID = "riko"
COMMANDS = {"type", "talk", "talk-start", "talk-stop", "toggle", "show", "hide", "forget",
            "personas", "persona", "persona-next", "quit", "status"}


def focus_window():
    """Wayland apps can't grab focus themselves, so ask the compositor (Hyprland) to do it.

    Hyprland 0.55+ (Lua config) reads `hyprctl dispatch X Y` as Lua, where the classic
    two-argument form is a syntax error; there the whole command goes in as one
    exec_raw string. Try classic first, fall back to the Lua form.
    """
    if not (os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl")):
        return
    target = f"focuswindow class:^({APP_ID})$"
    for args in (["dispatch", "focuswindow", target], ["dispatch", f'hl.dsp.exec_raw("{target}")']):
        if subprocess.run(["hyprctl", *args], capture_output=True, timeout=3).returncode == 0:
            return


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(__doc__)
    cmd = sys.argv[1]
    body = {}
    if cmd == "persona":
        name = " ".join(sys.argv[2:]).strip()
        if not name:
            sys.exit("riko-ctl persona <name>   (id, name or keyword, e.g. riko-ctl persona asuka)")
        body = {"name": name}
    if cmd in ("type", "show"):
        focus_window()
    request = urllib.request.Request(f"{URL}/control/{cmd}", data=json.dumps(body).encode(),
                                     method="POST", headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            reply = json.loads(response.read() or b"{}")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"riko-ctl: Riko isn't running at {URL} ({e}). Start it with: uv run desktop.py")
    if cmd == "type":
        focus_window()  # again, in case the window was hidden and only just mapped
    if cmd == "personas" and reply.get("ok", True):
        active = reply.get("active")
        for p in reply.get("personas", []):
            print(("* " if p["id"] == active else "  ") + f"{p['name']}  ({p['id']})")
        sys.exit(0)
    if cmd in ("status", "personas", "persona", "persona-next") or not reply.get("ok", True):
        print(json.dumps(reply))
    sys.exit(0 if reply.get("ok", True) else 1)


if __name__ == "__main__":
    main()
