#!/usr/bin/env python3
"""Control a running Riko desktop app from anywhere. OPTIONAL: her window has
its own configurable shortcuts (desktop.shortcuts in character_config.yaml,
never Super) for all of this; use riko-ctl when you want the same actions from
a compositor keybind or a script, without focusing her first.

    riko-ctl type         open the text box (and focus her window)
    riko-ctl talk         start / stop recording from your mic
    riko-ctl talk-start   start recording   (bind to key press)
    riko-ctl talk-stop    stop and send     (bind to key release)
    riko-ctl toggle       show / hide her   (also: show, hide)
    riko-ctl wave         she waves at you  (W in her window also works)
    riko-ctl forget       clear the chat history (on the hub, for this persona)
    riko-ctl personas     list personas and which one is active
    riko-ctl persona NAME switch who she is (id, name or keyword; case doesn't matter)
    riko-ctl persona-next switch to the next persona on the hub (cycles around)
    riko-ctl listen-mode  flip push_to_talk <-> always listen (or: listen-mode always / push_to_talk)
    riko-ctl name-gate    always-listen only: she answers just when the active
                        persona's name / keyword / alias is said (name-gate on | off;
                        also spelled: riko-ctl listen name-gate on|off)
    riko-ctl desktop-sense  flip "let her see my desktop" (or: desktop-sense on / off)
    riko-ctl dictation    flip dictation mode (or: dictation on / off) — what she
                        hears is typed into the focused window (docs/TYPING.md)
    riko-ctl stop-typing  abort the keystroke batch in progress
    riko-ctl approve        say yes to the action she is asking about (Enter in her window also works)
    riko-ctl deny           say no (Esc in her window also works; a timeout denies by itself)
    riko-ctl browser-status is the Riko Helper Firefox extension connected?
    riko-ctl browser-token  the pairing token for the Firefox extension (options page)
    riko-ctl obsidian-key   check/store the Obsidian Local REST API key
                            (no argument = hidden prompt, blank answer just
                             checks; `obsidian-key <key>` stores it; saved
                             0600 in ~/.config/riko/obsidian.json)
    riko-ctl quit
    riko-ctl status

Standard library only, so it starts fast and needs no virtualenv.
"""
import getpass
import json
import os
import shutil
import subprocess
import sys
import urllib.error
import urllib.request

URL = os.environ.get("RIKO_URL", "http://127.0.0.1:8080")
APP_ID = "riko"
COMMANDS = {"type", "talk", "talk-start", "talk-stop", "toggle", "show", "hide", "forget",
            "personas", "persona", "persona-next", "quit", "status",
            "approve", "deny", "browser-status", "browser-token", "wave", "listen-mode",
            "name-gate", "listen",
            "desktop-sense", "dictation", "stop-typing", "obsidian-key"}


def focus_window():
    """Wayland apps can't grab focus themselves, so ask the compositor (Hyprland) to do it.

    Hyprland 0.55+ (Lua config) reads `hyprctl dispatch X Y` as Lua, where the classic
    two-argument form is a syntax error; there the whole command goes in as one
    exec_raw string. Try classic first, fall back to the Lua form.
    """
    if not (os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl")):
        return
    target = f"focuswindow class:^({APP_ID})$"
    for args in (["dispatch", "focuswindow", target], ["dispatch", f'hl.dsp.exec_raw("{target}")']):
        if subprocess.run(["hyprctl", *args], capture_output=True, timeout=3).returncode == 0:
            return


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(__doc__)
    cmd = sys.argv[1]
    body = {}
    if cmd == "listen":
        # grouped spelling for the always-listen settings:
        # `riko-ctl listen name-gate on|off` == `riko-ctl name-gate on|off`
        if len(sys.argv) > 2 and sys.argv[2] == "name-gate":
            cmd = "name-gate"
            sys.argv = [sys.argv[0], "name-gate", *sys.argv[3:]]
        else:
            sys.exit("riko-ctl listen name-gate on|off")
    if cmd == "persona":
        name = " ".join(sys.argv[2:]).strip()
        if not name:
            sys.exit("riko-ctl persona <name>   (id, name or keyword, e.g. riko-ctl persona asuka)")
        body = {"name": name}
    if cmd == "listen-mode" and len(sys.argv) > 2:
        body = {"mode": sys.argv[2].strip().lower()}
    if cmd == "name-gate" and len(sys.argv) > 2:
        body = {"enabled": sys.argv[2].strip().lower()}
    if cmd == "desktop-sense" and len(sys.argv) > 2:
        body = {"enabled": sys.argv[2].strip().lower()}
    if cmd == "dictation" and len(sys.argv) > 2:
        body = {"enabled": sys.argv[2].strip().lower()}
    if cmd == "obsidian-key":
        # the key is a secret: prompt (hidden) when not given, and prefer
        # the tray dialog when there is no terminal to type into
        key = " ".join(sys.argv[2:]).strip()
        if not key and sys.stdin.isatty():
            key = getpass.getpass("Obsidian Local REST API key (blank = just check): ").strip()
        body = {"key": key}
    if cmd in ("type", "show"):
        focus_window()
    request = urllib.request.Request(f"{URL}/control/{cmd}", data=json.dumps(body).encode(),
                                     method="POST", headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            reply = json.loads(response.read() or b"{}")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"riko-ctl: Riko isn't running at {URL} ({e}). Start it with: uv run desktop.py")
    if cmd == "type":
        focus_window()  # again, in case the window was hidden and only just mapped
    if cmd == "personas" and reply.get("ok", True):
        active = reply.get("active")
        for p in reply.get("personas", []):
            print(("* " if p["id"] == active else "  ") + f"{p['name']}  ({p['id']})")
        sys.exit(0)
    if cmd == "browser-token" and reply.get("ok", True):
        print(f"token: {reply['token']}")
        print(f"port:  {reply.get('port')}")
        print(f"firefox extension connected: {'yes' if reply.get('connected') else 'no'}")
        sys.exit(0)
    if cmd == "obsidian-key" and reply.get("ok", True):
        if body.get("key"):
            print("Obsidian key saved (~/.config/riko/obsidian.json, 0600)")
        elif reply.get("set"):
            print("obsidian key: set")
        else:
            print("obsidian key: not set — riko-ctl obsidian-key <key> "
                  "or the tray Obsidian…")
        sys.exit(0)
    if cmd in ("status", "personas", "persona", "persona-next", "browser-status",
               "listen-mode", "name-gate", "desktop-sense", "dictation",
               "stop-typing") or not reply.get("ok", True):
        print(json.dumps(reply))
    sys.exit(0 if reply.get("ok", True) else 1)


if __name__ == "__main__":
    main()
