# Pull hub backups from the backup box onto the PC — systemd USER service.
# The destination ~/Backups/riko-hub is what the owner's second-copy tool
# should watch. See docs/BACKUPS.md.
#
# REQUIRED: backup_pull.sh has no personal default host. Before enabling
# the timer, add your remote to THIS INSTALLED unit
# (~/.config/systemd/user/riko-backup-pull.service), e.g.:
#   [Service]
#   Environment=RIKO_BACKUP_REMOTE=user@backupbox:Backups/riko-hub/
# (docs/BACKUPS.md has the copy-paste line for the owner's setup.)
[Unit]
Description=Pull Riko hub backups over ssh (docs/BACKUPS.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=1800
# Checkout path on the PC; adjust if the repo lives elsewhere.
ExecStart=%h/Development/riko_project/scripts/backup_pull.sh
